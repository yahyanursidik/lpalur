---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman tidak ditemukan — NataAlur" noindex>
  <section class="container nf">
    <img src="/assets/mark.webp" alt="" width="160" height="160" />
    <h1>Alurnya tidak ditemukan.</h1>
    <p>Halaman yang Anda cari tidak tersedia atau sudah dipindahkan.</p>
    <a href="/" class="btn btn--primary">Kembali ke beranda</a>
  </section>
</BaseLayout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    padding-block: clamp(4rem, 3rem + 6vw, 8rem) var(--section);
  }

  img {
    width: 72px;
    height: 72px;
  }

  h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  p {
    color: var(--muted);
  }
</style>
