---
import Icon from './Icon.astro';
import Scribble from './Scribble.astro';
import type { IconName } from '../data/site';

const steps: { t: string; chip: string; icon: IconName; status: string }[] = [
  { t: 'Pesanan diterima.', chip: 'Order penjualan', icon: 'inbox', status: 'Pesanan diterima' },
  { t: 'Bahan dan stok diperiksa.', chip: 'Reservasi stok', icon: 'package', status: 'Stok direservasi' },
  { t: 'Produksi dikerjakan.', chip: 'Perintah kerja & QC', icon: 'factory', status: 'Dalam produksi' },
  { t: 'Barang dikirim.', chip: 'Packing & surat jalan', icon: 'truck', status: 'Dikirim' },
  { t: 'Keuangan diperbarui.', chip: 'Invoice & jurnal', icon: 'wallet', status: 'Tercatat di keuangan' },
];
---

<section class="section flow" id="alur" aria-labelledby="alur-title">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <span class="eyebrow">Alur terhubung</span>
      <h2 id="alur-title">Dari pesanan sampai <Scribble variant="underline">selesai.</Scribble></h2>
      <p>Tak perlu memindahkan informasi berkali-kali. Setiap langkah memberi informasi ke bagian berikutnya dengan kontrol yang jelas.</p>
    </div>

    <div class="flow__track" data-flow>
      <svg class="flow__svg" viewBox="0 0 1000 140" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="flowGrad" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#154BA4" />
            <stop offset="1" stop-color="#079F77" />
          </linearGradient>
        </defs>
        <path class="flow__base" d="M100 70 C 150 20, 250 20, 300 70 S 450 120, 500 70 S 650 20, 700 70 S 850 120, 900 70" />
        <path class="flow__fill" data-flow-path pathLength="1" d="M100 70 C 150 20, 250 20, 300 70 S 450 120, 500 70 S 650 20, 700 70 S 850 120, 900 70" />
      </svg>
      <span class="flow__dot" data-flow-dot aria-hidden="true"></span>
      <div class="flow__vline" aria-hidden="true"><span></span></div>

      <ol class="flow__steps">
        {steps.map((s, i) => (
          <li class="fstep" data-flow-step data-status={s.status} style={`--k:${i}`}>
            <span class="fstep__node">
              <Icon name={s.icon} size={22} />
              <b class="fstep__n">{i + 1}</b>
            </span>
            <div class="fstep__txt">
              <h3>{s.t}</h3>
              <span class="fstep__chip"><Icon name="arrow" size={12} /> {s.chip}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="flow__doc" aria-hidden="true" data-reveal>
      <div class="flow__doc-card">
        <span class="flow__doc-ico"><Icon name="receipt" size={18} /></span>
        <div>
          <small>Pesanan SO-0142 · Pangkat custom instansi</small>
          <strong data-flow-status>{steps[0].status}</strong>
        </div>
        <div class="flow__doc-pips">
          {steps.map((_, i) => <i data-flow-pip style={`--k:${i}`}></i>)}
        </div>
      </div>
      <span class="label-illustration">Ilustrasi — data contoh</span>
    </div>

    <div class="flow__cta" data-reveal>
      <a href="#implementasi" class="btn">Cara implementasi <Icon name="arrow" size={18} class="icon--arrow" /></a>
    </div>
  </div>
</section>

<style is:global>
  .flow {
    overflow: hidden;
  }

  .flow__track {
    position: relative;
    margin-top: 12px;
  }

  .flow__svg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 140px;
    overflow: visible;
  }

  .flow__svg path {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .flow__base {
    stroke: var(--border-2);
    stroke-width: 3;
    stroke-dasharray: 2 8;
  }

  /* Tanpa non-scaling-stroke agar pathLength="1" akurat untuk progres. */
  .flow__fill {
    vector-effect: none;
    stroke: url(#flowGrad);
    stroke-width: 5;
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc(1 - var(--fp, 0));
  }

  .flow__dot {
    position: absolute;
    left: 0;
    top: 0;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: #fff;
    border: 4px solid var(--green);
    box-shadow: 0 0 0 6px rgb(7 159 119 / 0.18), 0 4px 10px rgb(7 159 119 / 0.4);
    transform: translate(var(--dx, 10%), var(--dy, 70px));
    opacity: var(--do, 0);
    z-index: 2;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .flow__vline {
    display: none;
  }

  .flow__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 0;
    margin: 0;
    list-style: none;
    z-index: 1;
  }

  .fstep {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-inline: 8px;
  }

  .fstep__node {
    position: relative;
    margin-top: 38px;
    width: 64px;
    height: 64px;
    border-radius: 20px;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--border-2);
    color: var(--muted);
    box-shadow: var(--shadow-sm);
    transition:
      background-color 0.5s var(--ease),
      color 0.5s var(--ease),
      border-color 0.5s,
      transform 0.6s var(--ease-spring),
      box-shadow 0.5s;
  }

  .fstep__n {
    position: absolute;
    top: -9px;
    right: -9px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 800;
    background: var(--surface);
    border: 1px solid var(--border-2);
    color: var(--muted);
    transition: inherit;
  }

  .fstep.is-on .fstep__node {
    color: #fff;
    border-color: transparent;
    background: linear-gradient(145deg, #2a63c4, var(--blue));
    transform: scale(1.06);
    box-shadow: 0 14px 26px -12px rgb(21 75 164 / 0.7);
  }

  .fstep:nth-child(n + 4).is-on .fstep__node {
    background: linear-gradient(145deg, #15bf8e, var(--green));
    box-shadow: 0 14px 26px -12px rgb(7 159 119 / 0.7);
  }

  .fstep.is-on .fstep__n {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }

  .fstep__txt {
    margin-top: 26px;
  }

  .fstep h3 {
    font-size: 1.08rem;
    letter-spacing: -0.015em;
    color: var(--muted);
    transition: color 0.4s;
  }

  .fstep.is-on h3 {
    color: var(--ink);
  }

  .fstep__chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    background: var(--surface-2);
    color: var(--muted);
    border: 1px solid var(--border);
    opacity: 0.5;
    transform: translateY(4px);
    transition: opacity 0.4s, transform 0.4s var(--ease), background-color 0.4s, color 0.4s, border-color 0.4s;
  }

  .fstep.is-on .fstep__chip {
    opacity: 1;
    transform: none;
    background: var(--green-50);
    color: var(--green-600);
    border-color: var(--green-100);
  }

  .flow__doc {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 56px;
  }

  .flow__doc-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    min-width: min(460px, 100%);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow);
  }

  .flow__doc-ico {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--blue-50);
    color: var(--blue);
    flex-shrink: 0;
  }

  .flow__doc-card small {
    display: block;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .flow__doc-card strong {
    display: block;
    font-family: var(--font-head);
    font-size: 1rem;
    animation: status-in 0.5s var(--ease);
  }

  @keyframes status-in {
    from { opacity: 0; transform: translateY(6px); }
  }

  .flow__doc-pips {
    margin-left: auto;
    display: flex;
    gap: 5px;
  }

  .flow__doc-pips i {
    width: 18px;
    height: 6px;
    border-radius: 6px;
    background: var(--border);
    transition: background-color 0.4s;
  }

  .flow__doc-pips i.is-on {
    background: var(--green);
  }

  .flow__cta {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }

  @media (max-width: 860px) {
    .flow__svg,
    .flow__dot {
      display: none;
    }

    .flow__vline {
      display: block;
      position: absolute;
      left: 31px;
      top: 32px;
      bottom: 60px;
      width: 3px;
      border-radius: 3px;
      background: var(--border);
    }

    .flow__vline span {
      display: block;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(var(--blue), var(--green));
      transform-origin: 50% 0;
      transform: scaleY(var(--fp, 0));
    }

    .flow__steps {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .fstep {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      gap: 20px;
      padding: 0;
    }

    .fstep__node {
      margin-top: 0;
      flex-shrink: 0;
    }

    .fstep__txt {
      margin-top: 8px;
    }

    .flow__doc-pips {
      display: none;
    }
  }
</style>
