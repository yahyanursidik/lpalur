---
import Icon from './Icon.astro';
import { modules, industries, problems } from '../data/site';
---

<header class="site-header" data-header>
  <div class="container header__inner">
    <a href="/" class="brand" aria-label="NataAlur — beranda">
      <img src="/assets/logo-horizontal.webp" alt="NataAlur ERP" width="720" height="178" />
    </a>

    <nav class="nav" aria-label="Navigasi utama">
      <ul class="nav__list">
        <li class="nav__item" data-dd>
          <button class="nav__link" type="button" aria-expanded="false" aria-controls="dd-solusi" data-dd-trigger data-spy="solusi">
            Solusi <Icon name="chevron" size={16} class="nav__chev" />
          </button>
          <div class="dd" id="dd-solusi" data-dd-panel>
            <div class="dd__card dd__card--solusi">
              <div class="dd__col">
                <p class="dd__title">Masalah yang diselesaikan</p>
                <ul>
                  {problems.map((p) => (
                    <li>
                      <a href="#solusi" class="dd__row">
                        <span class="dd__ico"><Icon name={p.icon} size={18} /></span>
                        <span>
                          <strong>{p.q}</strong>
                          <small>{p.a}</small>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="dd__col">
                <p class="dd__title">Untuk jenis usaha</p>
                <ul>
                  {industries.map((i) => (
                    <li>
                      <a href={`#industri`} class="dd__row" data-goto-industry={i.id}>
                        <span class="dd__ico dd__ico--green"><Icon name={i.icon} size={18} /></span>
                        <span>
                          <strong>{i.name}</strong>
                          <small>{i.desc}</small>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <a href="#alur" class="dd__feature">
                <svg class="dd__wave" viewBox="0 0 240 90" aria-hidden="true">
                  <path d="M-10 60 C 40 20, 80 90, 130 50 S 210 20, 250 40" />
                  <path d="M-10 74 C 40 34, 80 104, 130 64 S 210 34, 250 54" />
                </svg>
                <span class="dd__feature-k">Alur terhubung</span>
                <strong>Dari pesanan sampai selesai</strong>
                <span class="link-arrow">Lihat alurnya <Icon name="arrow" size={16} class="icon--arrow" /></span>
              </a>
            </div>
          </div>
        </li>
        <li class="nav__item" data-dd>
          <button class="nav__link" type="button" aria-expanded="false" aria-controls="dd-fitur" data-dd-trigger data-spy="fitur">
            Fitur <Icon name="chevron" size={16} class="nav__chev" />
          </button>
          <div class="dd" id="dd-fitur" data-dd-panel>
            <div class="dd__card dd__card--fitur">
              <p class="dd__title">Modul NataAlur</p>
              <ul class="dd__apps">
                {modules.map((m) => (
                  <li>
                    <a href="#fitur" class="dd__app" data-goto-module={m.id} style={`--hue:${m.hue}`}>
                      <span class="dd__app-ico"><Icon name={m.icon} size={20} /></span>
                      <span>
                        <strong>{m.name}</strong>
                        <small>{m.desc}</small>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <div class="dd__foot">
                <span>Modular, saling terhubung, dan bisa disesuaikan.</span>
                <a href="#fitur" class="link-arrow">Lihat semua modul <Icon name="arrow" size={16} class="icon--arrow" /></a>
              </div>
            </div>
          </div>
        </li>
        <li class="nav__item"><a class="nav__link" href="#industri" data-spy="industri">Industri</a></li>
        <li class="nav__item"><a class="nav__link" href="#implementasi" data-spy="implementasi">Implementasi</a></li>
      </ul>
    </nav>

    <div class="header__actions">
      <a href="#faq" class="btn btn--ghost btn--sm header__faq">FAQ</a>
      <a href="#kontak" class="btn btn--primary btn--sm header__cta">Diskusikan kebutuhan</a>
      <button class="burger" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div class="mnav" id="mobile-menu" data-mnav hidden>
    <div class="mnav__inner">
      <details class="mnav__group">
        <summary>Solusi <Icon name="chevron" size={18} /></summary>
        <ul>
          {problems.map((p) => (
            <li><a href="#solusi" data-mnav-link><Icon name={p.icon} size={18} /> {p.q}</a></li>
          ))}
          <li><a href="#alur" data-mnav-link><Icon name="route" size={18} /> Dari pesanan sampai selesai</a></li>
        </ul>
      </details>
      <details class="mnav__group">
        <summary>Fitur <Icon name="chevron" size={18} /></summary>
        <ul class="mnav__apps">
          {modules.map((m) => (
            <li>
              <a href="#fitur" data-mnav-link data-goto-module={m.id} style={`--hue:${m.hue}`}>
                <span class="dd__app-ico"><Icon name={m.icon} size={18} /></span> {m.name}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <a class="mnav__link" href="#industri" data-mnav-link>Industri</a>
      <a class="mnav__link" href="#implementasi" data-mnav-link>Implementasi</a>
      <a class="mnav__link" href="#faq" data-mnav-link>FAQ</a>
      <div class="mnav__cta">
        <a href="#kontak" class="btn btn--primary btn--lg" data-mnav-link>Diskusikan kebutuhan <Icon name="arrow" size={18} class="icon--arrow" /></a>
        <p>Self-hosted atau private cloud · Instalasi independen per perusahaan</p>
      </div>
    </div>
  </div>
</header>

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background-color 0.3s, box-shadow 0.3s, border-color 0.3s;
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    background: rgb(251 252 251 / 0.86);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom-color: var(--border);
  }

  /* backdrop-filter membuat containing block untuk elemen fixed; matikan saat menu mobile terbuka. */
  .site-header.is-open {
    background: var(--canvas);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header__inner {
    position: relative;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .brand {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    border-radius: 8px;
  }

  .brand img {
    width: auto;
    height: 36px;
  }

  .nav {
    margin-inline: auto;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 40px;
    padding: 0 14px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    font-family: var(--font-head);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink-2);
    position: relative;
    transition: background-color 0.2s, color 0.2s;
  }

  .nav__link:hover,
  .nav__link[aria-expanded='true'] {
    background: rgb(23 43 56 / 0.05);
    color: var(--ink);
  }

  .nav__link.is-active {
    color: var(--blue);
  }

  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 4px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--blue), var(--green));
  }

  .nav__chev {
    transition: transform 0.3s var(--ease);
    opacity: 0.6;
  }

  .nav__link[aria-expanded='true'] .nav__chev {
    transform: rotate(180deg);
  }

  /* Dropdown (mega menu) */
  .dd {
    position: absolute;
    top: calc(100% - 6px);
    left: 50%;
    padding-top: 10px;
    transform: translateX(-50%);
    width: min(860px, calc(100vw - 2 * var(--gutter)));
    pointer-events: none;
    visibility: hidden;
  }

  .dd__card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    padding: 22px;
    opacity: 0;
    transform: translateY(-8px) scale(0.985);
    transform-origin: 50% 0;
    transition: opacity 0.22s var(--ease), transform 0.32s var(--ease);
  }

  .nav__item.is-open .dd {
    pointer-events: auto;
    visibility: visible;
  }

  .nav__item.is-open .dd__card {
    opacity: 1;
    transform: none;
  }

  .dd__card--solusi {
    display: grid;
    grid-template-columns: 1fr 1fr 230px;
    gap: 18px;
  }

  .dd__title {
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 4px 10px 10px;
  }

  .dd__row {
    display: flex;
    gap: 12px;
    padding: 10px;
    border-radius: 12px;
    transition: background-color 0.2s;
  }

  .dd__row:hover {
    background: var(--surface-2);
  }

  .dd__row strong,
  .dd__app strong {
    display: block;
    font-family: var(--font-head);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .dd__row small,
  .dd__app small {
    display: block;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--muted);
    margin-top: 2px;
  }

  .dd__ico {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--blue-50);
    color: var(--blue);
    transition: transform 0.3s var(--ease-spring);
  }

  .dd__ico--green {
    background: var(--green-50);
    color: var(--green-600);
  }

  .dd__row:hover .dd__ico {
    transform: scale(1.08) rotate(-4deg);
  }

  .dd__feature {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 18px;
    border-radius: 14px;
    background: linear-gradient(160deg, var(--blue-50), var(--green-50));
    min-height: 220px;
  }

  .dd__feature strong {
    font-family: var(--font-head);
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .dd__feature-k {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--green-600);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .dd__wave {
    position: absolute;
    top: 16px;
    left: 0;
    width: 100%;
    height: 90px;
  }

  .dd__wave path {
    fill: none;
    stroke-width: 10;
    stroke-linecap: round;
    stroke-dasharray: 18 14;
    animation: dash-flow 3s linear infinite;
  }

  .dd__wave path:first-child {
    stroke: var(--blue);
    opacity: 0.5;
  }

  .dd__wave path:last-child {
    stroke: var(--green);
    opacity: 0.55;
    animation-direction: reverse;
  }

  @keyframes dash-flow {
    to {
      stroke-dashoffset: -64;
    }
  }

  .dd__apps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px 10px;
  }

  .dd__app {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: 12px;
    transition: background-color 0.2s;
  }

  .dd__app:hover {
    background: var(--surface-2);
  }

  .dd__app-ico {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    color: var(--hue);
    background: color-mix(in srgb, var(--hue) 12%, white);
    transition: transform 0.35s var(--ease-spring), background-color 0.25s, color 0.25s;
  }

  .dd__app:hover .dd__app-ico {
    background: var(--hue);
    color: #fff;
    transform: translateY(-2px) scale(1.06);
  }

  .dd__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 14px;
    padding: 14px 10px 0;
    border-top: 1px solid var(--border);
    font-size: 0.86rem;
    color: var(--muted);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  /* Burger */
  .burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    position: relative;
  }

  .burger span {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.35s var(--ease), opacity 0.2s, top 0.35s var(--ease);
  }

  .burger span:nth-child(1) { top: 15px; }
  .burger span:nth-child(2) { top: 21px; }
  .burger span:nth-child(3) { top: 27px; }

  .burger[aria-expanded='true'] span:nth-child(1) { top: 21px; transform: rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { top: 21px; transform: rotate(-45deg); }

  /* Mobile nav */
  .mnav {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--canvas);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.3s var(--ease), transform 0.35s var(--ease);
  }

  .mnav.is-open {
    opacity: 1;
    transform: none;
  }

  .mnav__inner {
    padding: 12px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
  }

  .mnav__group,
  .mnav__link {
    border-bottom: 1px solid var(--border);
  }

  .mnav__group summary,
  .mnav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    font-family: var(--font-head);
    font-size: 1.2rem;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }

  .mnav__group summary::-webkit-details-marker {
    display: none;
  }

  .mnav__group summary .icon {
    transition: transform 0.3s var(--ease);
  }

  .mnav__group[open] summary .icon {
    transform: rotate(180deg);
  }

  .mnav__group ul {
    padding-bottom: 14px;
  }

  .mnav__group li a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 46px;
    color: var(--ink-2);
    font-weight: 500;
  }

  .mnav__group li a > .icon {
    color: var(--blue);
  }

  .mnav__apps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 12px;
  }

  .mnav__apps .dd__app-ico {
    width: 34px;
    height: 34px;
    border-radius: 10px;
  }

  .mnav__cta {
    margin-top: 28px;
    display: grid;
    gap: 12px;
    text-align: center;
  }

  .mnav__cta p {
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 1080px) {
    .header__faq {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .nav,
    .header__cta {
      display: none;
    }

    .burger {
      display: block;
    }

    .header__actions {
      margin-left: auto;
    }
  }

  @media (max-width: 400px) {
    .mnav__apps {
      grid-template-columns: 1fr;
    }

    .brand img {
      height: 32px;
    }
  }
</style>
